{
    "name": "sanlilin/laravel-theme",
    "license": "MIT",
    "minimum-stability": "stable",
    "authors": [
        {
            "name": "wanghongbin",
            "email": "wanghongbin816@gmail.com"
        }
    ],
    "autoload": {
        "psr-4": {
            "Sanlilin\\LaravelTheme\\": "src/"
        },
        "files": [
            "src/Support/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Sanlilin\\LaravelTheme\\Tests\\": "tests",
            "ThemesTest\\": "tests/stubs/valid/"
        }
    },
    "require": {
        "ext-zip": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^8.0"
    },
    "scripts": {
        "test": "vendor/bin/phpunit"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Sanlilin\\LaravelTheme\\Providers\\ThemeServiceProvider"
            ]
        }
    }
}
